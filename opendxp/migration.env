# -------------------------------------------------------------
# Pimcore to OpenDXP Migration Configuration
# -------------------------------------------------------------

# Path to the old/source Pimcore local directory
SOURCE_PIMCORE_DIR=/home/luis/old-pimcore

# Optional path to a pre-existing database dump.
# If left empty, the script will dump directly from the SOURCE_DB_* credentials.
SOURCE_SQL_DUMP=

# Source Database Connection (Your old Pimcore database)
SOURCE_DB_HOST=
SOURCE_DB_PORT=
SOURCE_DB_USER=
SOURCE_DB_PASS=
SOURCE_DB_NAME=

# Target Database Connection (Prepopulated for local OpenDXP Docker environment)
TARGET_DB_HOST=
TARGET_DB_PORT=
TARGET_DB_USER=
TARGET_DB_PASS=
TARGET_DB_NAME=

# Target S3 Credentials (Hetzner S3 settings from production.tfvars)
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_BUCKET_PUBLIC=unimess
S3_BUCKET_PRIVATE=unimess
S3_PREFIX_ASSETS=pimcore/assets
S3_PREFIX_THUMBNAILS=opendxp/production/public
S3_PREFIX_VERSIONS=opendxp/production/private
AWS_ACCESS_KEY_ID=PTQF5D2Y4KTP0A732YZ6
AWS_SECRET_ACCESS_KEY=fTu47xKPuXsctqRPTkpH1HncxsANpMd9msiaC0Kw
AWS_DEFAULT_REGION=nbg-1
